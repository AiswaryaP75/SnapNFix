{
  "name": "snapnfix",
  "version": "1.0.0",
  "private": true,
  "description": "Community civic issue reporting and resolution platform",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
